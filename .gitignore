# ========================================================
#  .gitignore — projet Flask (campa-expo)
# ========================================================

# ---------- Environnements virtuels Python ----------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ---------- Bytecode / cache Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo

# ---------- Outils de build / packaging ----------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Tests & couverture ----------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
hypothesis/

# ---------- Environnement & secrets ----------
.env
.env.*
!.env.example
*.env
env.py
.flaskenv
instance/
*.sqlite
*.sqlite3
*.db

# ---------- Logs ----------
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ---------- Flask ----------
# Dossier instance local (base de données, config locale)
instance/
# Fichiers temporaires du serveur de développement
*.pid
*.restart

# ---------- Assets front / Tailwind ----------
node_modules/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
# NB : package-lock.json est volontairement VERSIONNÉ (install reproductible).
#      static/css/output-style.css est le CSS compilé, également versionné.

# ---------- Déploiement ----------
.Python
.venv.bak/
*.manifest
*.spec

# ---------- Fichiers personnels / artefacts locaux ----------
# Configurations de shell et d'outils créées automatiquement à la racine.
# Elles dépendent de la machine (ou du sandbox) : jamais versionnées.
.bashrc
.bash_profile
.bash_login
.bash_logout
.zshrc
.zprofile
.zlogin
.zlogout
.profile
.inputrc
.ripgreprc
.gitconfig
.mcp.json
# .gitmodules est normalement ajouté par git pour les sous-modules :
# retirez cette ligne si vous utilisez des sous-modules.
.gitmodules

# ---------- Éditeurs / IDE ----------
# (sans "/" final : ces entrées existent tantôt en fichier, tantôt en dossier)
.idea
.vscode
.claude/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.vim/
.project
.pydevproject
.spyderproject
.spyproject
# Pour versionner une config VS Code partagée, remplacez la ligne ".vscode"
# ci-dessus par :
#   .vscode/*
#   !.vscode/settings.json
#   !.vscode/launch.json
#   !.vscode/extensions.json
#   !.vscode/tasks.json

# ---------- Système d'exploitation ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
